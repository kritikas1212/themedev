{{ 'section-product-reel-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="product-reel-grid section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-reel-grid__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="product-reel-grid__container grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_reel_short = false
            assign video_url_string = block.settings.video_url | default: ''
            
            if video_url_string != blank
              if video_url_string contains 'instagram.com/reel' or video_url_string contains 'instagram.com/p/'
                assign is_reel_short = true
              elsif video_url_string contains 'youtube.com/shorts/'
                assign is_reel_short = true
              elsif video_url_string contains 'tiktok.com/' or video_url_string contains 'vm.tiktok.com'
                assign is_reel_short = true
              endif
            endif
            
            assign wrapper_class = 'product-reel-grid__video-wrapper'
            if is_reel_short
              assign wrapper_class = wrapper_class | append: ' product-reel-grid__video-wrapper--reel'
            endif
          -%}
          <div class="product-reel-grid__item grid__item" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'video_link' -%}
                {%- if block.settings.video_url != blank -%}
                  <div class="{{ wrapper_class }}">
                    {%- liquid
                      assign video_id = ''
                      assign video_type = ''
                      assign is_reel_short = false
                      assign video_url_string = block.settings.video_url | default: ''
                      
                      if video_url_string != blank
                        if video_url_string contains 'youtube.com/shorts/'
                          assign video_id = video_url_string | split: '/shorts/' | last | split: '?' | first
                          assign video_type = 'youtube'
                          assign is_reel_short = true
                        elsif video_url_string contains 'youtube.com/watch' or video_url_string contains 'youtu.be/'
                          if video_url_string contains 'youtube.com/watch'
                            assign video_id = video_url_string | split: 'v=' | last | split: '&' | first
                          elsif video_url_string contains 'youtu.be/'
                            assign video_id = video_url_string | split: '/' | last | split: '?' | first
                          endif
                          assign video_type = 'youtube'
                          assign is_reel_short = false
                        elsif video_url_string contains 'instagram.com/reel' or video_url_string contains 'instagram.com/p/'
                          assign video_type = 'instagram'
                          assign video_id = video_url_string
                          assign is_reel_short = true
                        elsif video_url_string contains 'tiktok.com/' or video_url_string contains 'vm.tiktok.com'
                          assign video_type = 'tiktok'
                          assign video_id = video_url_string
                          assign is_reel_short = true
                        elsif video_url_string contains 'vimeo.com'
                          assign video_id = video_url_string | split: '/' | last | split: '?' | first
                          assign video_type = 'vimeo'
                        else
                          assign video_type = 'direct'
                        endif
                      endif
                    -%}
                    
                    {%- liquid
                      assign video_muted = block.settings.video_muted | default: true
                      assign mute_param = ''
                      if video_muted
                        assign mute_param = '&mute=1'
                      endif
                      assign reel_class = ''
                      if is_reel_short
                        assign reel_class = 'product-reel-grid__video--reel'
                      endif
                    -%}
                    
                    {%- if video_type == 'youtube' and video_id != blank -%}
                      <div class="product-reel-grid__video product-reel-grid__video--youtube {{ reel_class }}">
                        <iframe
                          src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1&autoplay=1&loop=1&playlist={{ video_id }}{{ mute_param }}"
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                          title="{{ block.settings.caption | default: 'Product reel' | escape }}"
                        ></iframe>
                      </div>
                    {%- elsif video_type == 'instagram' -%}
                      <div class="product-reel-grid__video product-reel-grid__video--instagram {{ reel_class }}">
                        {%- comment -%}
                          Instagram Reels/Posts - Use oEmbed API or embed
                          Note: Instagram requires oEmbed API for proper embedding
                        {%- endcomment -%}
                        <blockquote class="instagram-media" data-instgrm-permalink="{{ video_id }}" data-instgrm-version="14" style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:100%; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);">
                          <div style="padding:16px;">
                            <a href="{{ video_id }}" style="background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;" target="_blank">
                              <div style="display: flex; flex-direction: row; align-items: center;">
                                <div style="background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;"></div>
                                <div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center;">
                                  <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;"></div>
                                  <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;"></div>
                                </div>
                              </div>
                              <div style="padding: 19% 0;"></div>
                              <div style="display:block; height:50px; margin:0 auto 12px; width:50px;">
                                <svg width="50px" height="50px" viewBox="0 0 60 60" version="1.1">
                                  <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-511.000000, -20.000000)" fill="#000000">
                                      <g>
                                        <path d="M556.869,30.41 C554.814,30.41 553.148,32.076 553.148,34.131 C553.148,36.186 554.814,37.852 556.869,37.852 C558.924,37.852 560.59,36.186 560.59,34.131 C560.59,32.076 558.924,30.41 556.869,30.41 M541,60.657 C535.114,60.657 530.342,55.887 530.342,50 C530.342,44.114 535.114,39.342 541,39.342 C546.887,39.342 551.658,44.114 551.658,50 C551.658,55.887 546.887,60.657 541,60.657 M541,33.886 C532.1,33.886 524.886,41.1 524.886,50 C524.886,58.899 532.1,66.113 541,66.113 C549.9,66.113 557.115,58.899 557.115,50 C557.115,41.1 549.9,33.886 541,33.886 M565.378,62.101 C565.244,65.022 564.756,66.606 564.346,67.663 C563.803,69.06 563.154,70.057 562.106,71.106 C561.058,72.155 560.06,72.803 558.662,73.347 C557.607,73.757 556.021,74.244 553.102,74.378 C549.944,74.521 548.997,74.552 541,74.552 C533.003,74.552 532.056,74.521 528.898,74.378 C525.979,74.244 524.393,73.757 523.338,73.347 C521.94,72.803 520.942,72.155 519.894,71.106 C518.846,70.057 518.197,69.06 517.654,67.663 C517.244,66.606 516.755,65.022 516.623,62.101 C516.479,58.943 516.448,57.996 516.448,50 C516.448,42.003 516.479,41.056 516.623,37.899 C516.755,34.978 517.244,33.391 517.654,32.338 C518.197,30.938 518.846,29.942 519.894,28.894 C520.942,27.846 521.94,27.196 523.338,26.654 C524.393,26.244 525.979,25.756 528.898,25.623 C532.057,25.479 533.004,25.448 541,25.448 C548.997,25.448 549.943,25.479 553.102,25.623 C556.021,25.756 557.607,26.244 558.662,26.654 C560.06,27.196 561.058,27.846 562.106,28.894 C563.154,29.942 563.803,30.938 564.346,32.338 C564.756,33.391 565.244,34.978 565.378,37.899 C565.522,41.056 565.552,42.003 565.552,50 C565.552,57.996 565.522,58.943 565.378,62.101 M570.82,37.631 C570.674,34.438 570.167,32.258 569.425,30.349 C568.659,28.377 567.633,26.702 565.965,25.035 C564.297,23.368 562.623,22.342 560.652,21.575 C558.743,20.834 556.562,20.326 553.369,20.18 C550.169,20.033 549.148,20 541,20 C532.853,20 531.831,20.033 528.631,20.18 C525.438,20.326 523.257,20.834 521.349,21.575 C519.376,22.342 517.703,23.368 516.035,25.035 C514.368,26.702 513.342,28.377 512.574,30.349 C511.834,32.258 511.326,34.438 511.181,37.631 C511.035,40.831 511,41.851 511,50 C511,58.147 511.035,59.17 511.181,62.369 C511.326,65.562 511.834,67.743 512.574,69.651 C513.342,71.625 514.368,73.296 516.035,74.965 C517.703,76.634 519.376,77.658 521.349,78.425 C523.257,79.167 525.438,79.673 528.631,79.82 C531.831,79.965 532.853,80.001 541,80.001 C549.148,80.001 550.169,79.965 553.369,79.82 C556.562,79.673 558.743,79.167 560.652,78.425 C562.623,77.658 564.297,76.634 565.965,74.965 C567.633,73.296 568.659,71.625 569.425,69.651 C570.167,67.743 570.674,65.562 570.82,62.369 C570.966,59.17 571,58.147 571,50 C571,41.851 570.966,40.831 570.82,37.631"></path>
                                      </g>
                                    </g>
                                  </g>
                                </svg>
                              </div>
                              <div style="padding-top: 8px;">
                                <div style="color:#3897f0; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:550; line-height:18px;">View this post on Instagram</div>
                              </div>
                              <div style="padding: 12.5% 0;"></div>
                            </a>
                          </div>
                        </blockquote>
                        <script async src="https://www.instagram.com/embed.js"></script>
                      </div>
                    {%- elsif video_type == 'tiktok' -%}
                      <div class="product-reel-grid__video product-reel-grid__video--tiktok {{ reel_class }}">
                        {%- comment -%}
                          TikTok embed - requires blockquote format
                        {%- endcomment -%}
                        <blockquote class="tiktok-embed" cite="{{ video_id }}" data-video-id="{{ video_id | split: '/' | last | split: '?' | first }}" style="max-width:605px;min-width:325px;">
                          <section>
                            <a target="_blank" title="@username" href="{{ video_id }}"></a>
                          </section>
                        </blockquote>
                        <script async src="https://www.tiktok.com/embed.js"></script>
                      </div>
                    {%- elsif video_type == 'vimeo' and video_id != blank -%}
                      <div class="product-reel-grid__video product-reel-grid__video--vimeo {{ reel_class }}">
                        <iframe
                          src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0&autoplay=1&loop=1{% if video_muted %}&muted=1{% endif %}"
                          frameborder="0"
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                          title="{{ block.settings.caption | default: 'Product reel' | escape }}"
                        ></iframe>
                      </div>
                    {%- elsif video_type == 'direct' -%}
                      {%- liquid
                        assign direct_video_url = block.settings.video_url | default: ''
                      -%}
                      {%- if direct_video_url != blank -%}
                        <div class="product-reel-grid__video product-reel-grid__video--direct {{ reel_class }}">
                          <video
                            {% if video_muted %}muted{% endif %}
                            autoplay
                            loop
                            playsinline
                            controls
                            preload="auto"
                            loading="lazy"
                          >
                            <source src="{{ direct_video_url }}" type="video/mp4">
                            <source src="{{ direct_video_url }}" type="video/webm">
                            Your browser does not support the video tag.
                          </video>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    
                    {%- if block.settings.caption != blank -%}
                      <p class="product-reel-grid__caption">{{ block.settings.caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              
              {%- when 'video_upload' -%}
                {%- comment -%} Legacy video_upload block type - kept for backward compatibility {%- endcomment -%}
                {%- if block.settings.video != blank -%}
                  {%- liquid
                    assign video_muted = block.settings.video_muted | default: true
                  -%}
                  <div class="product-reel-grid__video-wrapper">
                    <div class="product-reel-grid__video product-reel-grid__video--upload">
                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '1100x',
                          autoplay: true,
                          loop: true,
                          controls: true,
                          muted: video_muted,
                          preload: 'auto',
                          playsinline: true
                      }}
                    </div>
                    {%- if block.settings.caption != blank -%}
                      <p class="product-reel-grid__caption">{{ block.settings.caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- when 'video_unified' -%}
                {%- comment -%} Unified block: Standard Shopify pattern - both upload and link options {%- endcomment -%}
                {%- liquid
                  assign video_muted = block.settings.video_muted | default: true
                -%}
                
                {%- if block.settings.video != blank -%}
                  {%- comment -%} Uploaded video takes priority {%- endcomment -%}
                  <div class="product-reel-grid__video-wrapper">
                    <div class="product-reel-grid__video product-reel-grid__video--upload">
                      {{
                        block.settings.video
                        | video_tag:
                          image_size: '1100x',
                          autoplay: true,
                          loop: true,
                          controls: true,
                          muted: video_muted,
                          preload: 'auto',
                          playsinline: true
                      }}
                    </div>
                    {%- if block.settings.caption != blank -%}
                      <p class="product-reel-grid__caption">{{ block.settings.caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- elsif block.settings.video_url != blank -%}
                  {%- comment -%} Video from URL {%- endcomment -%}
                  {%- liquid
                    assign video_id = ''
                    assign video_type = ''
                    assign is_reel_short = false
                    assign video_url_string = block.settings.video_url | default: ''
                    
                    if video_url_string != blank
                      if video_url_string contains 'youtube.com/shorts/'
                        assign video_id = video_url_string | split: '/shorts/' | last | split: '?' | first
                        assign video_type = 'youtube'
                        assign is_reel_short = true
                      elsif video_url_string contains 'youtube.com/watch' or video_url_string contains 'youtu.be/'
                        if video_url_string contains 'youtube.com/watch'
                          assign video_id = video_url_string | split: 'v=' | last | split: '&' | first
                        elsif video_url_string contains 'youtu.be/'
                          assign video_id = video_url_string | split: '/' | last | split: '?' | first
                        endif
                        assign video_type = 'youtube'
                        assign is_reel_short = false
                      elsif video_url_string contains 'instagram.com/reel' or video_url_string contains 'instagram.com/p/'
                        assign video_type = 'instagram'
                        assign video_id = video_url_string
                        assign is_reel_short = true
                      elsif video_url_string contains 'tiktok.com/' or video_url_string contains 'vm.tiktok.com'
                        assign video_type = 'tiktok'
                        assign video_id = video_url_string
                        assign is_reel_short = true
                      elsif video_url_string contains 'vimeo.com'
                        assign video_id = video_url_string | split: '/' | last | split: '?' | first
                        assign video_type = 'vimeo'
                      else
                        assign video_type = 'direct'
                      endif
                    endif
                  -%}
                  
                  {%- liquid
                    assign mute_param = ''
                    if video_muted
                      assign mute_param = '&mute=1'
                    endif
                    assign reel_class = ''
                    if is_reel_short
                      assign reel_class = 'product-reel-grid__video--reel'
                    endif
                    assign wrapper_class = 'product-reel-grid__video-wrapper'
                    if is_reel_short
                      assign wrapper_class = wrapper_class | append: ' product-reel-grid__video-wrapper--reel'
                    endif
                  -%}
                  
                  <div class="{{ wrapper_class }}">
                    {%- if video_type == 'youtube' and video_id != blank -%}
                      <div class="product-reel-grid__video product-reel-grid__video--youtube {{ reel_class }}">
                        <iframe
                          src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1&autoplay=1&loop=1&playlist={{ video_id }}{{ mute_param }}"
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                          title="{{ block.settings.caption | default: 'Product reel' | escape }}"
                        ></iframe>
                      </div>
                    {%- elsif video_type == 'instagram' -%}
                      <div class="product-reel-grid__video product-reel-grid__video--instagram {{ reel_class }}">
                        <blockquote class="instagram-media" data-instgrm-permalink="{{ video_id }}" data-instgrm-version="14" style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:100%; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);">
                          <div style="padding:16px;">
                            <a href="{{ video_id }}" style="background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;" target="_blank">
                              <div style="display: flex; flex-direction: row; align-items: center;">
                                <div style="background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;"></div>
                                <div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center;">
                                  <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;"></div>
                                  <div style="background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;"></div>
                                </div>
                              </div>
                              <div style="padding: 19% 0;"></div>
                              <div style="display:block; height:50px; margin:0 auto 12px; width:50px;">
                                <svg width="50px" height="50px" viewBox="0 0 60 60" version="1.1">
                                  <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g transform="translate(-511.000000, -20.000000)" fill="#000000">
                                      <g>
